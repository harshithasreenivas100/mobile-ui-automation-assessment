# Copy this file to .env and adjust for your machine. .env is git-ignored.
# Values already set in your shell (or by cross-env) take precedence over this file.

# --- Platform and device ---------------------------------------------------
# android | ios
PLATFORM=android
# Android: any label (the first connected emulator/device is used unless UDID is set).
# iOS: a simulator name from `xcrun simctl list devices available`, e.g. iPhone 17
DEVICE_NAME=Realdevice
# Optional: pin an OS version and/or a specific device
 PLATFORM_VERSION=13
UDID=a0f5ef03

# --- Appium server ---------------------------------------------------------
APPIUM_SERVER_URL=http://127.0.0.1:4723

# --- App under test (Sauce Labs sample app 2.7.1) --------------------------
# Android .apk; iOS simulator .app (an .ipa only runs on real devices). A URL is also accepted.
ANDROID_APP_PATH=./apps/Android.SauceLabs.Mobile.Sample.app.2.7.1.apk
IOS_APP_PATH=./apps/iOS.Simulator.SauceLabs.Mobile.Sample.app.2.7.1.app
# Used to restart the app between scenarios. Defaults match the 2.7.1 builds.
 ANDROID_APP_PACKAGE=com.swaglabsmobileapp
 IOS_BUNDLE_ID=com.saucelabs.SwagLabsMobileApp

# --- Test data (public demo credentials from the Sauce Labs sample app) ----
APP_USERNAME=standard_user
APP_PASSWORD=secret_sauce

# --- Execution -------------------------------------------------------------
# Explicit wait timeout in milliseconds
WAIT_TIMEOUT=10000
# Cucumber tag expression, e.g. @smoke or "@regression and not @wip". Empty runs everything.
CUCUMBER_TAGS=
# Scenario-level retries. Keep at 0 unless you are deliberately quarantining a known flake.
RETRIES=0
# debug | info | warn | error
LOG_LEVEL=info
